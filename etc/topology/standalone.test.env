# standalone.test
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_ENVIRONMENT=test
SDKWORK_BIRDCODER_PROFILE_ID=standalone.test
SDKWORK_BIRDCODER_ALLOWED_ORIGINS=https://birdcoder-test.sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://birdcoder-test.sdkwork.com
SDKWORK_ENV=test
SDKWORK_ENVIRONMENT=test
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=https://birdcoder-test.sdkwork.com
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=https://birdcoder-test.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# IAM embedded application bootstrap (IAM_APPLICATION_BOOTSTRAP_SPEC §5.1)
SDKWORK_APP_ROOT=.
SDKWORK_BIRDCODER_APP_ROOT=.

# SDKWork Deploy module (api-assembly composed into the standalone gateway;
# production-like profile: drive goes through the gateway's own Drive API
# facade, remaining runtime values are injected by the deployment platform)
SDKWORK_DEPLOY_ENVIRONMENT=test
SDKWORK_DRIVE_FACADE_URL=https://birdcoder-test.sdkwork.com
