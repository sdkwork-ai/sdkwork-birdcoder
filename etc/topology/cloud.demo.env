# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_birdcoder_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_birdcoder_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BIRDCODER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_BIRDCODER_PROFILE_ID=cloud.demo
SDKWORK_BIRDCODER_PC_DESKTOP_DEV_BIND=127.0.0.1:1520
SDKWORK_BIRDCODER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:1520,http://localhost:1520,http://code-demo.sdkwork.com:10240
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:1520,http://localhost:1520,http://code-demo.sdkwork.com:10240

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn

SDKWORK_IM_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_ENVIRONMENT=demo
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://code-demo.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://code-demo.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# SDKWork Deploy module (api-assembly composed into the standalone gateway;
# development uses the in-memory drive/content-provider ports so the full
# publish pipeline writes its local persistence without extra hosts)
SDKWORK_DEPLOY_ENVIRONMENT=demo
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_DEPLOY_SNOWFLAKE_NODE_ID=1
SDKWORK_BIRDCODER_WEB_DEV_INGRESS_BIND=127.0.0.1:5173
SDKWORK_BIRDCODER_PC_INTERNAL_DEV_PORT=5175
SDKWORK_BIRDCODER_H5_INTERNAL_DEV_PORT=5176


