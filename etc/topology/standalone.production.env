# standalone.production
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_ENVIRONMENT=production
SDKWORK_BIRDCODER_PROFILE_ID=standalone.production
SDKWORK_CORS_ALLOWED_ORIGINS=https://code.sdkwork.com,https://code.birdcoder.com,https://code.dtupay.com,https://code.noaper.com,https://code.sdkwork.cn,https://code.birdcoder.cn,https://code.dtupay.cn,https://code.noaper.cn,https://code.skubc.com,https://code.skubc.cn,https://code.zowalk.com,https://code.zowalk.cn,https://code.offer86.com,https://code.offer86.cn,https://code.86offer.com,https://code.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_ENVIRONMENT=production
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:10240
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:10240


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn

# IAM embedded application bootstrap (IAM_APPLICATION_BOOTSTRAP_SPEC §5.1)
SDKWORK_APP_ROOT=.
SDKWORK_BIRDCODER_APP_ROOT=.

# SDKWork Deploy module (api-assembly composed into the standalone gateway;
# production-like profile: drive goes through the gateway's own Drive API
# facade, remaining runtime values are injected by the deployment platform)
SDKWORK_DEPLOY_ENVIRONMENT=production
SDKWORK_DRIVE_FACADE_URL=http://127.0.0.1:10240
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:10240
SDKWORK_BIRDCODER_PC_STATIC_ROOT=/usr/share/sdkwork/birdcoder/web/pc
