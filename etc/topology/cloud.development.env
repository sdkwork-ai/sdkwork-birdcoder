# cloud.development
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BIRDCODER_ENVIRONMENT=development
SDKWORK_BIRDCODER_PROFILE_ID=cloud.development
SDKWORK_BIRDCODER_PC_DEV_BIND=127.0.0.1:5173
SDKWORK_BIRDCODER_PC_DESKTOP_DEV_BIND=127.0.0.1:1520
SDKWORK_BIRDCODER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:1520,http://localhost:1520,http://birdcoder-dev.sdkwork.com:10240
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:1520,http://localhost:1520,http://birdcoder-dev.sdkwork.com:10240


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_ENVIRONMENT=dev
SDKWORK_ENV=dev
SDKWORK_ENVIRONMENT=development
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://birdcoder-dev.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://birdcoder-dev.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

# SDKWork Deploy module (api-assembly composed into the standalone gateway;
# development uses the in-memory drive/content-provider ports so the full
# publish pipeline writes its local persistence without extra hosts)
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_DEPLOY_SNOWFLAKE_NODE_ID=1
