# cloud.development
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BIRDCODER_ENVIRONMENT=development
SDKWORK_BIRDCODER_PROFILE_ID=cloud.development
SDKWORK_BIRDCODER_PC_DESKTOP_DEV_BIND=127.0.0.1:1520
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:1520,http://localhost:1520,http://127.0.0.1:5173,http://localhost:5173,https://code-dev.sdkwork.com,http://code-dev.sdkwork.com,https://code-dev.birdcoder.com,http://code-dev.birdcoder.com,https://code-dev.dtupay.com,http://code-dev.dtupay.com,https://code-dev.noaper.com,http://code-dev.noaper.com,https://code-dev.sdkwork.cn,http://code-dev.sdkwork.cn,https://code-dev.birdcoder.cn,http://code-dev.birdcoder.cn,https://code-dev.dtupay.cn,http://code-dev.dtupay.cn,https://code-dev.noaper.cn,http://code-dev.noaper.cn,https://code-dev.skubc.com,http://code-dev.skubc.com,https://code-dev.skubc.cn,http://code-dev.skubc.cn,https://code-dev.zowalk.com,http://code-dev.zowalk.com,https://code-dev.zowalk.cn,http://code-dev.zowalk.cn,https://code-dev.offer86.com,http://code-dev.offer86.com,https://code-dev.offer86.cn,http://code-dev.offer86.cn,https://code-dev.86offer.com,http://code-dev.86offer.com,https://code-dev.86offer.cn,http://code-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER_REGION_CODE=cn

SDKWORK_IM_ENVIRONMENT=dev
SDKWORK_ENV=dev
SDKWORK_ENVIRONMENT=development
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://code-dev.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://code-dev.sdkwork.com:10240
VITE_SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

# SDKWork Deploy module (api-assembly composed into the standalone gateway;
# development uses the in-memory drive/content-provider ports so the full
# publish pipeline writes its local persistence without extra hosts)
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_DEPLOY_SNOWFLAKE_NODE_ID=1
SDKWORK_BIRDCODER_WEB_DEV_INGRESS_BIND=127.0.0.1:5173
SDKWORK_BIRDCODER_PC_INTERNAL_DEV_PORT=5175
SDKWORK_BIRDCODER_H5_INTERNAL_DEV_PORT=5176


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
