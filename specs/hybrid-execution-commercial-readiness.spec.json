  "forbiddenClaimsUntilAllGatesDone": [
    "cloud execution available",
    "production Sandbox isolation",
    "commercial multi-tenant isolation",
    "high-concurrency distributed execution ready",
    "runtime pool ready"
  ],
  "humanReview": {
    "required": true,
    "entryReview": "docs/engineering/reviews/REVIEW-20260730-hybrid-execution-commercial-gate.md",
