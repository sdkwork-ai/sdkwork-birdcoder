    "../sdkwork-kernel/docs/architecture/decisions/ADR-20260730-distributed-execution-placement-control-plane.md",
    "../sdkwork-kernel/docs/engineering/reviews/REVIEW-20260730-distributed-execution-placement.md",
    "../sdkwork-kernel/docs/product/prd/PRD-05-distributed-agent-runtime.md",
    "../sdkwork-sandbox/docs/product/requirements/REQ-2026-0019-sandbox-runtime-pool-and-fast-allocation.md",
    "../sdkwork-sandbox/docs/product/requirements/REQ-2026-0021-sandbox-workspace-runtime-transaction-and-checkpoint.md",
