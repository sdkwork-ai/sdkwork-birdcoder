{
  "schemaVersion": 1,
  "kind": "sdkwork.hybrid-agent-execution-commercial-readiness",
  "status": "blocked",
  "updatedAt": "2026-07-30",
  "scope": [
    "sdkwork-birdcoder",
    "sdkwork-agents",
    "sdkwork-kernel",
    "sdkwork-sandbox"
  ],
  "summary": "BirdCoder may expose per-Session local or cloud execution only through the Agents product API. Agents owns durable intent and orchestration, Kernel owns placement and execution leases, and Sandbox owns isolated runtime, pool, attachment, and cleanup mechanisms. Cloud execution remains unavailable until every protected upstream gate is approved and proven.",
  "dependencyDirection": [
    "sdkwork-birdcoder -> sdkwork-agents -> sdkwork-kernel -> sdkwork-sandbox",
    "sdkwork-birdcoder -/-> sdkwork-kernel",
    "sdkwork-birdcoder -/-> sdkwork-sandbox",
    "sdkwork-agents -/-> sdkwork-sandbox",
    "sdkwork-sandbox -/-> sdkwork-kernel",
    "sdkwork-sandbox -/-> sdkwork-agents"
  ],
  "vocabulary": {
    "clientRuntimeTarget": {
      "owner": "sdkwork-birdcoder runtime composition",
      "examples": ["browser", "desktop", "server"],
      "isExecutionTarget": false
    },
    "deploymentProfile": {
      "owner": "deployment composition",
      "values": ["standalone", "cloud"],
      "isPerSessionChoice": false
    },
    "executionPreference": {
      "candidateOwner": "sdkwork-agents",
      "values": ["LOCAL", "CLOUD"],
      "requiredOnSession": true,
      "taskOverrideValues": ["LOCAL", "CLOUD"],
      "automaticOrArbitraryValueAllowed": false,
      "isResolvedPlacement": false,
      "humanReviewRequiredBeforePublicApi": true
    },
    "resolvedExecutionTarget": {
      "owner": "sdkwork-kernel",
      "values": ["client_local", "managed_sandbox"],
      "serverOwned": true,
      "clientMaySet": false,
      "immutableAfterExecutionAccepted": true
    },
    "coordinationMode": {
      "owner": "sdkwork-kernel deployment runtime",
      "values": ["single", "cluster"],
      "isExecutionTarget": false,
      "isPerSessionChoice": false
    },
    "runtimeRole": {
      "owner": "sdkwork-kernel deployment runtime",
      "values": ["gateway", "coordinator", "worker"],
      "isExecutionTarget": false,
      "isPerSessionChoice": false
    },
    "fallbackPolicy": {
      "owner": "sdkwork-kernel execution orchestration",
      "values": ["none", "before_start_only"],
      "default": "none",
      "afterSideEffectFallbackAllowed": false
    },
    "dataResidency": {
      "owner": "sdkwork-agents deployment and persistence composition",
      "localExecutionAloneImpliesDeviceOnlyResidency": false,
      "allDataLocalClaimRequiresDeviceLocalAgentsAuthority": true,
      "sessionPersistenceAuthorityImmutableAfterCreation": true,
      "implicitCrossResidencyReplicationAllowed": false,
      "status": "pending-human-review"
    },
    "runtimeBinding": {
      "owner": "sdkwork-agents",
      "clientMayCreatePlacementBinding": false,
      "clientMayWriteRuntimeLocationHostOrTransport": false,
      "opaqueRuntimeLocationRequiredWhenReady": true,
      "currentLocalPreLaunchTransition": {
        "status": "temporary",
        "birdcoderCreatesCombinedRuntimeBinding": true,
        "requiresOpaqueDeviceRuntimeLocation": true,
        "mayBeUsedAsCloudPlacementEvidence": false,
        "mustBeRetiredByGate": "HXE-003"
      }
    },
    "placementLease": {
      "owner": "sdkwork-kernel",
      "requiresLeaseToken": true,
      "requiresMonotonicFencing": true,
      "leaseCredentialNeverLeavesKernel": true,
      "agentsPersistsLeaseCredential": false,
      "callerSelectedNodePoolOrProviderAllowed": false
    },
    "sandboxPoolClaim": {
      "owner": "sdkwork-sandbox",
      "tenantNeutralBeforeClaim": true,
      "workspaceAttachmentAfterClaim": true,
      "releaseRequiresSanitizationEvidence": true
    }
  },
  "capabilityNegotiation": {
    "authority": "sdkwork-agents",
    "source": "reviewed live Kernel and Sandbox evidence",
    "authenticated": true,
    "contractVersionRequired": true,
    "expiryRequired": true,
    "stableUnavailableReasonRequired": true,
    "deploymentProfileInferenceAllowed": false,
    "clientRuntimeInferenceAllowed": false,
    "buildTimeBooleanAcceptedAsCommercialEvidence": false
  },
  "dataOwnership": {
    "workspaceProjectSessionTurnTask": "sdkwork-agents PostgreSQL authority",
    "runtimePlacementLeaseAndExecutionOwnership": "sdkwork-kernel transient runtime authority",
    "sandboxRuntimePoolClaimAttachmentAndCleanup": "sdkwork-sandbox authority",
    "localProjectBytes": "device filesystem selected through a typed BirdCoder host adapter",
    "cloudProjectBytes": "persistent workspace storage authority attached to an allocated Sandbox",
    "birdcoderLocalDatabaseAllowedFacts": [
      "bounded device preferences",
      "opaque device mount identity",
      "secure desktop session material through the operating-system credential store"
    ],
    "birdcoderLocalDatabaseForbiddenFacts": [
      "Workspace",
      "Project",
      "Session",
      "Turn",
      "Task",
      "Runtime Binding",
      "Sandbox Pool Claim"
    ]
  },
  "candidateAgentsPlacementPort": {
    "status": "human-review-required",
    "operations": [
      "reserve",
      "renew",
      "release",
      "cancelExecution",
      "restoreCheckpoint"
    ],
    "requestFields": [
      "tenantId",
      "organizationId",
      "ownerUserId",
      "workspaceId",
      "projectId",
      "sessionId",
      "turnOrTaskId",
      "executionPreference",
      "runtimeProfileId",
      "idempotencyKey",
      "deadline"
    ],
    "responseFields": [
      "placementId",
      "executionTarget",
      "runtimeBindingId",
      "leaseId",
      "fencingToken",
      "expiresAt",
      "opaqueRuntimeLocationId"
    ]
  },
  "cloudAllocationOrdering": [
    "agents_authorizes_session_and_execution_intent",
    "kernel_claims_execution_ownership",
    "sandbox_admission_reservation_confirmed",
    "sandbox_verified_node_and_capacity_confirmed",
    "sandbox_pool_slot_claimed",
    "sandbox_workspace_network_and_resource_grants_applied",
    "sandbox_provider_started_and_effective_readiness_verified",
    "kernel_placement_lease_ready",
    "agents_runtime_binding_activated",
    "birdcoder_receives_capability_and_binding_summary"
  ],
  "releaseGates": [
    {
      "id": "HXE-001",
      "owner": "sdkwork-birdcoder",
      "title": "Separate execution target from client host mode",
      "status": "done"
    },
    {
      "id": "HXE-002",
      "owner": "sdkwork-birdcoder",
      "title": "Require an opaque mounted local runtime location before Session binding",
      "status": "done"
    },
    {
      "id": "HXE-003",
      "owner": "sdkwork-agents",
      "title": "Approve and implement Session and Task execution preference plus server-owned placement orchestration",
      "status": "blocked-human-review"
    },
    {
      "id": "HXE-004",
      "owner": "sdkwork-kernel",
      "title": "Approve and implement single and cluster placement leases, routing, cancellation, recovery, and fencing",
      "status": "blocked-draft-authority"
    },
    {
      "id": "HXE-005",
      "owner": "sdkwork-sandbox",
      "title": "Approve and implement production runtime pool, isolation, storage attachment, and sanitization",
      "status": "blocked-human-review"
    },
    {
      "id": "HXE-006",
      "owner": "cross-repository-release",
      "title": "Produce real KVM, multi-tenant isolation, load, failover, recovery, supply-chain, and operational evidence",
      "status": "blocked-missing-evidence"
    }
  ],
  "authorityEvidence": [
