  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-birdcoder-standalone-gateway",
            "binary": "sdkwork-api-birdcoder-standalone-gateway",
            "runtimeTargets": [
              "browser",
              "server",
              "test-runner",
              "capacitor-ios",
              "capacitor-android",
              "flutter-ios",
              "flutter-android"
            ],
            "env": {
              "SDKWORK_BIRDCODER_RUNTIME_TARGET": "server"
            },
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "birdcoder-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-birdcoder-pc",
            "bindEnv": "SDKWORK_BIRDCODER_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          },
          {
            "id": "h5-capacitor-renderer",
            "applicationRoot": "apps/sdkwork-birdcoder-h5",
            "package": "@sdkwork/birdcoder-h5",
            "script": "start:browser",
            "runtimeTargets": [
              "capacitor-ios",
              "capacitor-android"
            ],
            "clientArchitectures": [
              "capacitor"
            ],
            "env": {
              "VITE_SDKWORK_RUNTIME_TARGET": "capacitor"
            },
            "bindEnv": "SDKWORK_BIRDCODER_WEB_DEV_INGRESS_BIND",
            "required": true,
            "role": "client"
          },
          {
            "id": "pc-desktop-renderer",
            "applicationRoot": "apps/sdkwork-birdcoder-pc",
            "package": "@sdkwork/birdcoder-pc-desktop",
            "script": "start:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "env": {
              "SDKWORK_BIRDCODER_RUNTIME_TARGET": "desktop",
              "VITE_SDKWORK_BIRDCODER_RUNTIME_TARGET": "desktop"
            },
            "bindEnv": "SDKWORK_BIRDCODER_PC_DESKTOP_DEV_BIND",
            "required": true,
            "role": "client"
          },
          {
            "id": "flutter-android-client",
            "applicationRoot": "apps/sdkwork-birdcoder-flutter-mobile",
            "script": "_sdkwork:client:flutter-android",
            "runtimeTargets": [
              "flutter-android"
            ],
            "clientArchitectures": [
              "flutter"
            ],
            "required": true,
            "role": "client"
          },
          {
            "id": "flutter-ios-client",
            "applicationRoot": "apps/sdkwork-birdcoder-flutter-mobile",
            "script": "_sdkwork:client:flutter-ios",
            "runtimeTargets": [
              "flutter-ios"
            ],
            "clientArchitectures": [
              "flutter"
            ],
            "required": true,
            "role": "client"
          },
          {
            "id": "pc-web-test-runner",
            "applicationRoot": "apps/sdkwork-birdcoder-pc",
            "package": "@sdkwork/birdcoder-pc-web",
            "script": "start:browser:check",
            "runtimeTargets": [
              "test-runner"
            ],
            "env": {
              "SDKWORK_BIRDCODER_RUNTIME_TARGET": "test-runner",
              "VITE_SDKWORK_BIRDCODER_RUNTIME_TARGET": "test-runner"
            },
            "bindEnv": "SDKWORK_BIRDCODER_WEB_DEV_INGRESS_BIND",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [],
        "browserDeliveries": [
          {
            "id": "birdcoder-adaptive-web",
            "applicationRoot": "apps/sdkwork-birdcoder-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "birdcoder-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-birdcoder-pc/packages/sdkwork-birdcoder-pc-web",
                "command": "node",
                "args": [
                  "../../../../scripts/run-vite-host.mjs",
                  "serve",
                  "--mode",
                  "development",
                  "--host",
                  "{host}",
                  "--port",
                  "{port}",
                  "--strictPort"
                ],
                "defaultPort": 5175,
                "portEnv": "SDKWORK_BIRDCODER_PC_INTERNAL_DEV_PORT",
                "env": {
                  "SDKWORK_BIRDCODER_RUNTIME_TARGET": "browser",
                  "VITE_SDKWORK_BIRDCODER_RUNTIME_TARGET": "browser",
                  "VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL": "{httpOrigin}"
                }
              },
              "h5": {
