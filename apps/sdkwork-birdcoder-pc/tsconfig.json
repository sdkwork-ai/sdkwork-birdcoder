{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "react": [
        "./../../node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./../../node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "./../../node_modules/@types/react/jsx-dev-runtime.d.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "sdkwork-birdcoder-commons/shell": [
        "./packages/sdkwork-birdcoder-pc-workbench/src/shell.ts"
      ],
      "sdkwork-birdcoder-*": [
        "./packages/sdkwork-birdcoder-pc-*/src"
      ],
      "@sdkwork/birdcoder-app-sdk": [
        "../../sdks/sdkwork-birdcoder-app-sdk/sdkwork-birdcoder-app-sdk-typescript/src/index.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@sdkwork/sdk-common": [
        "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/index.ts"
      ],
      "@sdkwork/sdk-common/*": [
        "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/*"
      ]
    }
  },
  "include": [
    "src",
    "packages"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/src-tauri/target/**",
    "../../scripts/vite-shims/sdkwork-core-pc-react-browser-facade.mjs",
    "packages/sdkwork-birdcoder-pc-workbench/src/terminal/birdcoderTerminalInfrastructureRuntime.ts",
    "artifacts/**"
  ]
}
