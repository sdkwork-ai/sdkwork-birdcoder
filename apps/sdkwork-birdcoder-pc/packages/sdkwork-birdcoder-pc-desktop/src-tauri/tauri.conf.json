{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDKWork BirdCoder",
  "version": "0.1.0",
  "identifier": "com.sdkwork.birdcoder.desktop",
  "build": {
    "beforeDevCommand": "pnpm start:desktop-renderer",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1520"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* https: ws: wss:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    },
    "windows": [
      {
        "label": "main",
        "title": "Birdcoder",
        "decorations": false,
        "center": true,
        "minWidth": 1200,
        "minHeight": 760,
        "width": 1440,
        "height": 960
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../../../artifacts/desktop-provider-host/provider-host/": "provider-host/",
      "../../../../../artifacts/models-catalog/": "models-catalog/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
