{
  "schemaVersion": 1,
  "kind": "sdkwork.component-deployment",
  "application": "sdkwork-birdcoder-mini-program",
  "parentDeploymentConfig": "../../../etc/sdkwork.deployment.config.json",
  "parentTopologySpec": "../../../specs/topology.spec.json",
  "runtimeConfig": "mini-program.runtime.json",
  "materialization": {
    "authority": "../../../etc/sdkwork.deployment.config.json",
    "command": "pnpm config:materialize",
    "format": "mini-program-json",
    "outputPattern": "../config/mini-program/runtime-env.{deploymentProfile}.{environment}.json",
    "profiles": [
      "standalone.development",
      "standalone.test",
      "standalone.staging",
      "standalone.production",
      "cloud.development",
      "cloud.test",
      "cloud.staging",
      "cloud.production"
    ]
  }
}
