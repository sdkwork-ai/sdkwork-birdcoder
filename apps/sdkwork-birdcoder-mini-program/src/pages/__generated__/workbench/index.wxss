.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 5%, rgba(37, 99, 235, 0.28), transparent 34%),
    linear-gradient(180deg, #0b1020 0%, #10182b 100%);
}

.hero-card,
.state-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 32rpx;
  background: rgba(15, 23, 42, 0.88);
  box-shadow: 0 24rpx 64rpx rgba(2, 6, 23, 0.32);
}

.hero-card {
  padding: 36rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.eyebrow,
.state-kicker {
  color: #60a5fa;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 6rpx;
  color: #f8fafc;
  font-size: 48rpx;
  font-weight: 750;
}

.summary {
  display: block;
  margin-top: 28rpx;
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1.6;
}

.profile-pill {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.18);
  color: #93c5fd;
  font-size: 22rpx;
}

.state-card {
  display: flex;
  min-height: 440rpx;
  margin-top: 28rpx;
  padding: 44rpx 36rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.state-card.ready {
  border-color: rgba(34, 197, 94, 0.34);
}

.state-card.warning {
  border-color: rgba(245, 158, 11, 0.34);
}

.state-card.error {
  border-color: rgba(239, 68, 68, 0.34);
}

.state-title {
  display: block;
  margin-top: 18rpx;
  color: #f8fafc;
  font-size: 38rpx;
  font-weight: 700;
}

.state-copy {
  display: block;
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 26rpx;
  line-height: 1.7;
}

.spinner {
  width: 52rpx;
  height: 52rpx;
  border: 6rpx solid rgba(96, 165, 250, 0.24);
  border-top-color: #60a5fa;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.capability-list {
  width: 100%;
  margin-top: 30rpx;
}

.capability-item {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  color: #cbd5e1;
  font-size: 25rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #22c55e;
}

.primary-action {
  width: 100%;
  margin-top: 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
}

.footer-note {
  display: flex;
  margin-top: 32rpx;
  flex-direction: column;
  align-items: center;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.8;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
