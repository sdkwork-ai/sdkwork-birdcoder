# sdkwork-birdcoder docker compose environment template.
# Copy to the compose directory as `.env` and adjust values:
#   cp docker/.env.example .env
# docker compose reads `.env` next to docker-compose.yml automatically.
# Every value below has a built-in local-development default, so this file is
# optional; it exists to make deployment-time configuration explicit.

# --- Process log level (tracing reads RUST_LOG directly) ---
# Set to debug/trace to increase verbosity at deployment time.
RUST_LOG=info

# --- Gateway resource guardrails (docker compose deploy limits) ---
BIRDCODER_CPU_LIMIT=4.0
BIRDCODER_MEMORY_LIMIT=4g
BIRDCODER_CPU_RESERVATION=1.0
BIRDCODER_MEMORY_RESERVATION=1g

# --- Connection pools ---
BIRDCODER_DATABASE_MAX_CONNECTIONS=30
BIRDCODER_DATABASE_MIN_CONNECTIONS=3
BIRDCODER_DATABASE_ACQUIRE_TIMEOUT=30
BIRDCODER_DATABASE_IDLE_TIMEOUT=600
BIRDCODER_DATABASE_MAX_LIFETIME=1800
# PostgreSQL server-side connection ceiling (default 200).
PG_MAX_CONNECTIONS=200

# --- Gateway environment ---
# Deployment environment: development | test | staging | production.
BIRDCODER_ENVIRONMENT=test
# Application public HTTP URL advertised by the deployment (the primary test
# domain; all three docker test domains proxy to the same gateway).
BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://testapidocker.sdkwork.com
# Browser CORS allow-list for the API plane (comma separated). This is the
# canonical shared key (SOURCE_CONFIG_SPEC) used by every SDKWork API surface.
SDKWORK_CORS_ALLOWED_ORIGINS=http://testapidocker.sdkwork.com,http://testapidocker.birdcoder.com,http://testapidocker.dtupay.com,http://localhost:10243,http://127.0.0.1:10243

# --- PostgreSQL (compose `postgres` service) ---
BIRDCODER_POSTGRES_DB=sdkwork_ai_test
BIRDCODER_POSTGRES_SCHEMA=sdkwork_ai_test
BIRDCODER_POSTGRES_USER=sdkwork_ai_test
# Change this password; the same value reaches the app via the database env.
# `pnpm deploy:apply:standalone` replaces this line with a freshly generated
# random password when it creates deployments/docker/.env.
BIRDCODER_POSTGRES_PASSWORD=change-me-to-a-random-password

# --- IAM bootstrap account ---
# Default admin password credential, provisioned at startup when set.
# Production deployments must set a strong password here.
BIRDCODER_IAM_SUPER_ADMIN_PASSWORD=
